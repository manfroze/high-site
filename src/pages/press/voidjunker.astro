---
// Void Junker press kit — hijinks.uno/press/voidjunker/
// Assets live in public/press/voidjunker/ (screenshots are the Steam store's
// 1920x1080 set; logo and capsules come from void-junker/art/store/).
// The zip is built from those folders. Rebuild it after changing any asset:
//   cd public/press/voidjunker && rm -f void-junker-press-kit.zip && zip -qr void-junker-press-kit.zip logo art screenshots
const BASE = '/press/voidjunker';
const ITCH = 'https://highlyintegratedgayhijink.itch.io/voidjunker';
const STEAM = 'https://store.steampowered.com/app/5396740/Void_Junker/';
const TRAILER_ID = '28u8nob0gGM';
const EMAIL = 'highlyintegratedgayhijinks@gmail.com';

const screenshots = [
  { n: '01', alt: 'Stage one: the hauler drilling an asteroid in open space' },
  { n: '02', alt: 'Stage two: blue rock around a ringed planet' },
  { n: '03', alt: 'The hangar yard counter: drills, tractors, holds and guns for credits' },
  { n: '04', alt: 'Two tender ships selling upgrades mid-run' },
  { n: '05', alt: 'Stage two: the walled arena around a station' },
  { n: '06', alt: 'Stage three: charged copper rock throwing lightning' },
  { n: '07', alt: 'Stage three: lightning arcing off a copper asteroid' },
];

const art = [
  { file: 'logo/void-junker-logo.png', label: 'Logo', size: '2026×1022 PNG, transparent', dark: true },
  { file: 'art/void-junker-ship.png', label: 'The hauler', size: '707×804 PNG, transparent', dark: true },
  { file: 'art/void-junker-capsule-1232x706.png', label: 'Key art, landscape', size: '1232×706 PNG' },
  { file: 'art/void-junker-capsule-600x900.png', label: 'Key art, portrait', size: '600×900 PNG' },
  { file: 'art/void-junker-header-920x430.png', label: 'Header', size: '920×430 PNG' },
  { file: 'art/void-junker-hero-3840x1240.png', label: 'Wide banner', size: '3840×1240 PNG' },
  { file: 'logo/high-studio-logo.svg', label: 'Studio logo', size: 'SVG', light: true },
];
---
<html lang="en">
<head>
  <!-- Google Analytics -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HQTQQN1JEX"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-HQTQQN1JEX');
  </script>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Void Junker · Press Kit</title>
  <meta name="description" content="Press kit for Void Junker, a top-down 3D sci-fi mining roguelite by Highly Integrated Gay Hijinks. Free browser demo on itch.io, coming to Steam." />
  <meta property="og:title" content="Void Junker · Press Kit" />
  <meta property="og:description" content="These asteroids yearn to be mined. Fact sheet, trailer, screenshots, logos and key art." />
  <meta property="og:image" content={`https://hijinks.uno${BASE}/art/void-junker-capsule-1232x706.png`} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=VT323&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --void: #07080d;
      --hull: #12141c;
      --plate: #1b1e29;
      --rivet: #2c3142;
      --text: #e6e8ef;
      --dim: #9298ab;
      --junk: #e2472b;      /* the logo's red */
      --rust: #e08a3c;      /* the hauler's orange */
      --ore: #4f7dd9;       /* stage two's blue rock */
      --led: #6be08f;       /* the gauges' green */
      --mono: 'VT323', ui-monospace, Menlo, monospace;
      --sans: 'Space Grotesk', system-ui, sans-serif;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
    body {
      margin: 0; background: var(--void); color: var(--text);
      font: 17px/1.6 var(--sans);
      background-image:
        radial-gradient(1px 1px at 12% 18%, #fff8 50%, transparent 51%),
        radial-gradient(1px 1px at 72% 9%, #fff6 50%, transparent 51%),
        radial-gradient(1px 1px at 38% 62%, #fff5 50%, transparent 51%),
        radial-gradient(1px 1px at 88% 44%, #fff7 50%, transparent 51%),
        radial-gradient(1px 1px at 22% 88%, #fff4 50%, transparent 51%),
        radial-gradient(1px 1px at 61% 78%, #fff6 50%, transparent 51%);
      background-size: 420px 420px;
      background-attachment: fixed;
    }
    a { color: var(--rust); }
    a:hover { color: #ffb070; }
    a:focus-visible, button:focus-visible { outline: 2px solid var(--led); outline-offset: 3px; }
    .wrap { max-width: 1120px; margin: 0 auto; padding-inline: 20px; }
    .mono { font-family: var(--mono); }
    .tag { font: 20px/1 var(--mono); color: var(--led); letter-spacing: .04em; text-transform: uppercase; }

    /* hero */
    .hero { padding-block: 56px 40px; display: grid; grid-template-columns: minmax(0,1.1fr) minmax(0,.9fr); gap: 32px; align-items: center; }
    .hero h1 { margin: 0; }
    .hero h1 img { width: 100%; max-width: 560px; height: auto; display: block; }
    .hero .ship { justify-self: center; max-width: 320px; width: 70%; height: auto; filter: drop-shadow(0 0 40px #e08a3c33); }
    .lede { font-size: 22px; line-height: 1.45; margin: 18px 0 8px; max-width: 34ch; }
    .sub { color: var(--dim); margin: 0 0 24px; max-width: 52ch; }
    .ctas { display: flex; flex-wrap: wrap; gap: 10px; }
    .btn {
      display: inline-flex; align-items: center; gap: 8px; text-decoration: none;
      font: 22px/1 var(--mono); letter-spacing: .03em; text-transform: uppercase;
      padding: 12px 16px; border: 2px solid var(--rivet); background: var(--plate); color: var(--text);
    }
    .btn:hover { border-color: var(--rust); color: var(--text); }
    .btn.primary { background: var(--junk); border-color: var(--junk); color: #fff; }
    .btn.primary:hover { background: #f05a3d; border-color: #f05a3d; }
    .btn small { font-size: 16px; opacity: .75; }

    /* nav */
    nav.jump { position: sticky; top: 0; z-index: 5; background: #07080dee; backdrop-filter: blur(6px); border-block: 1px solid var(--rivet); }
    nav.jump .wrap { display: flex; gap: 4px; overflow-x: auto; padding-block: 6px; }
    nav.jump a { font: 20px/1 var(--mono); text-transform: uppercase; color: var(--dim); text-decoration: none; padding: 8px 10px; white-space: nowrap; }
    nav.jump a:hover { color: var(--text); }

    section { padding-block: 56px 8px; scroll-margin-top: 56px; }
    h2 { font: 36px/1 var(--mono); text-transform: uppercase; letter-spacing: .03em; margin: 0 0 22px; color: var(--text); display: flex; align-items: baseline; gap: 14px; }
    h2::before { content: ''; width: 14px; height: 14px; background: var(--junk); flex: none; transform: translateY(-2px); }
    h3 { font: 26px/1.1 var(--mono); text-transform: uppercase; color: var(--rust); margin: 28px 0 6px; letter-spacing: .02em; }

    /* trailer */
    .video { position: relative; aspect-ratio: 16 / 9; max-width: 100%; background: #000; border: 2px solid var(--rivet); }
    .video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

    /* facts + text */
    .two { display: grid; grid-template-columns: minmax(0, 340px) minmax(0, 1fr); gap: 40px; align-items: start; }
    .facts { background: var(--hull); border: 2px solid var(--rivet); padding: 6px 18px; margin: 0; }
    .facts div { padding: 12px 0; border-bottom: 1px dashed var(--rivet); }
    .facts div:last-child { border-bottom: 0; }
    .facts dt { font: 18px/1 var(--mono); text-transform: uppercase; color: var(--led); letter-spacing: .05em; margin-bottom: 4px; }
    .facts dd { margin: 0; font-size: 15.5px; overflow-wrap: anywhere; }
    .facts dd span { color: var(--dim); }
    .prose { max-width: 66ch; }
    .prose p { margin: 0 0 14px; }
    .prose .open { font-size: 20px; }

    /* gallery */
    .shots { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 14px; }
    .shots a { display: block; border: 2px solid var(--rivet); background: #000; line-height: 0; }
    .shots a:hover { border-color: var(--rust); }
    .shots img { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }
    .note { color: var(--dim); font-size: 15px; margin: 14px 0 0; }

    .art { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; }
    .art a { display: grid; grid-template-rows: 170px auto; text-decoration: none; color: var(--text); border: 2px solid var(--rivet); background: var(--hull); }
    .art a:hover { border-color: var(--rust); }
    .art .thumb { display: grid; place-items: center; padding: 14px; background: #000 center / 18px 18px; overflow: hidden; }
    .art .thumb.light { background: #f2f2f2; }
    .art .thumb img { max-width: 100%; max-height: 140px; width: auto; height: auto; }
    .art .meta { padding: 10px 12px; display: grid; gap: 2px; border-top: 1px solid var(--rivet); }
    .art .meta b { font: 20px/1.1 var(--mono); text-transform: uppercase; letter-spacing: .03em; }
    .art .meta span { color: var(--dim); font-size: 14px; }

    .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 18px; }
    .panel { background: var(--hull); border: 2px solid var(--rivet); padding: 18px 20px; }
    .panel h3 { margin-top: 0; }
    .panel p, .panel ul { margin: 0 0 10px; }
    .panel ul { padding-left: 18px; }
    .panel li { margin-bottom: 4px; }
    .email { font: 24px/1.2 var(--mono); color: var(--text); overflow-wrap: anywhere; user-select: all; }

    footer { padding-block: 64px 48px; color: var(--dim); font-size: 14px; }
    footer .wrap { display: flex; flex-wrap: wrap; gap: 12px 24px; justify-content: space-between; align-items: center; }
    footer img { height: 34px; width: auto; }

    @media (max-width: 820px) {
      .hero { grid-template-columns: minmax(0, 1fr); padding-top: 32px; }
      .hero .ship { display: none; }
      .two { grid-template-columns: minmax(0, 1fr); }
      .lede { font-size: 20px; }
    }
    @media (max-width: 420px) {
      .wrap { padding-inline: 16px; }
      .shots { grid-template-columns: minmax(0, 1fr); }
    }
  </style>
</head>
<body>
  <header class="wrap hero">
    <div>
      <span class="tag">Press kit</span>
      <h1><img src={`${BASE}/logo/void-junker-logo.png`} alt="Void Junker" width="2026" height="1022" /></h1>
      <p class="lede">These asteroids yearn to be mined.</p>
      <p class="sub">A top-down 3D sci-fi mining roguelite. Drill asteroids, haul the ore home in a battered hauler, and decide what to do about the people in your way. The demo is free to play in the browser now.</p>
      <div class="ctas">
        <a class="btn primary" href={ITCH}>Play the demo <small>free · itch.io</small></a>
        <a class="btn" href={STEAM}>Wishlist on Steam</a>
        <a class="btn" href={`${BASE}/void-junker-press-kit.zip`} download>Download all <small>zip · 3.2 MB</small></a>
      </div>
    </div>
    <img class="ship" src={`${BASE}/art/void-junker-ship.png`} alt="" width="707" height="804" />
  </header>

  <nav class="jump" aria-label="Sections">
    <div class="wrap">
      <a href="#trailer">Trailer</a>
      <a href="#facts">Fact sheet</a>
      <a href="#screenshots">Screenshots</a>
      <a href="#art">Logos &amp; art</a>
      <a href="#creators">For creators</a>
      <a href="#contact">Contact</a>
    </div>
  </nav>

  <main class="wrap">
    <section id="trailer">
      <h2>Trailer</h2>
      <div class="video">
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${TRAILER_ID}`}
          title="Void Junker trailer"
          loading="lazy"
          allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen></iframe>
      </div>
      <p class="note">On YouTube: <a href={`https://www.youtube.com/watch?v=${TRAILER_ID}`}>youtube.com/watch?v={TRAILER_ID}</a></p>
    </section>

    <section id="facts">
      <h2>Fact sheet</h2>
      <div class="two">
        <dl class="facts">
          <div><dt>Developer &amp; publisher</dt><dd>Highly Integrated Gay Hijinks</dd></div>
          <div><dt>Release</dt><dd>Coming soon to Steam<br /><span>Free demo out now on itch.io</span></dd></div>
          <div><dt>Platforms</dt><dd>Windows, macOS, SteamOS + Linux<br /><span>Demo: web browser</span></dd></div>
          <div><dt>Genre</dt><dd>Top-down 3D action roguelite, mining, sci-fi</dd></div>
          <div><dt>Players</dt><dd>Single-player</dd></div>
          <div><dt>Languages</dt><dd>English</dd></div>
          <div><dt>Price</dt><dd>To be announced</dd></div>
          <div><dt>Demo</dt><dd>Three stages, about 30 minutes, keyboard and mouse</dd></div>
          <div><dt>Links</dt><dd><a href={ITCH}>itch.io</a> · <a href={STEAM}>Steam</a> · <a href="https://hijinks.uno/">hijinks.uno</a></dd></div>
        </dl>

        <div class="prose">
          <p class="open">Course through more than 30 stages in a battered mining hauler. Drill asteroids apart face by face, pull the loose ore into your hold with a tractor beam, blast whoever comes for it, and get it home. Ore isn't yours until you do, and a full hold makes you slow, heavy and worth robbing.</p>

          <h3>Mine and shoot</h3>
          <p>Every asteroid is built from ore-bearing faces. Choose where to cut, break the shell, crack the core, and tractor in what spills out. Your drill and your guns run off the same power, so every second is a choice between earning and defending. Drills overheat: feather the trigger to keep cutting, or hold it and pay for the cooldown.</p>

          <h3>More than 30 stages</h3>
          <p>Every stage changes the rules and ends in its own finale. Lay belts of rock across your path, fly through fields of charged copper that throw lightning between rocks, race a crowd to a gold rush, thread a tunnel bored through a giant asteroid, mine a field so dark you only see where your light falls, or drill crystal that bends your beam onto whatever lies beyond. Bosses range from gutted capital ships to guarded stations and lattices of live, sparking nodes.</p>

          <h3>Make choices</h3>
          <p>Prospectors work the same rock you do. They're unarmed, so shooting them is easy and profitable, and the game keeps count. How you treat the people around you decides which way your story goes.</p>

          <h3>Upgrade your junker</h3>
          <p>Sell ore and spend the credits in the hangar yard on better drills, guns, tractors, hulls and holds. Mid-run, dock with the tender ships that follow the field and trade ore straight for upgrades.</p>

          <h3>Built like it's 1998</h3>
          <p>Low-poly models, wobbling vertices and dithered colour, framed by a panel of working instruments: a radar, gauges, a radio and a dot-matrix display for every system.</p>

          <h3>Soundtrack by Ozzed</h3>
          <p>Chiptune and electronic music by <a href="https://ozzed.net/">Ozzed</a>.</p>
        </div>
      </div>
    </section>

    <section id="screenshots">
      <h2>Screenshots</h2>
      <div class="shots">
        {screenshots.map((s) => (
          <a href={`${BASE}/screenshots/void-junker-${s.n}.jpg`} title="Open full size (1920×1080)">
            <img src={`${BASE}/preview/void-junker-${s.n}.jpg`} alt={s.alt} width="960" height="540" loading="lazy" />
          </a>
        ))}
      </div>
      <p class="note">Click any shot for the full 1920×1080 JPG. All of them are in the <a href={`${BASE}/void-junker-press-kit.zip`} download>zip</a>.</p>
    </section>

    <section id="art">
      <h2>Logos &amp; art</h2>
      <div class="art">
        {art.map((a) => (
          <a href={`${BASE}/${a.file}`}>
            <span class={`thumb${a.light ? ' light' : ''}`}><img src={`${BASE}/${a.file}`} alt="" loading="lazy" /></span>
            <span class="meta"><b>{a.label}</b><span>{a.size}</span></span>
          </a>
        ))}
      </div>
      <p class="note">The logo is white and red on a transparent background: put it on something dark.</p>
    </section>

    <section id="creators">
      <h2>For creators</h2>
      <div class="cols">
        <div class="panel">
          <h3>Videos &amp; streams</h3>
          <p>You're free to stream, record and monetise Void Junker. No need to ask first.</p>
        </div>
        <div class="panel">
          <h3>Music</h3>
          <p>The soundtrack is by <a href="https://ozzed.net/">Ozzed</a>, licensed <a href="https://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA 3.0</a>: Don't Be a Bitch (remix), Ferrous Rage, Final Breath, Human Factory Reset, Lesser Than Three and Cor Metallicum.</p>
        </div>
        <div class="panel">
          <h3>Keys</h3>
          <p>The demo is free on itch.io and needs no key. For a Steam key once there's a Steam build, write to the address below.</p>
        </div>
      </div>
    </section>

    <section id="contact">
      <h2>Contact</h2>
      <div class="cols">
        <div class="panel">
          <h3>Press &amp; creators</h3>
          <p class="email">{EMAIL}</p>
          <p>Highly Integrated Gay Hijinks</p>
        </div>
        <div class="panel">
          <h3>Follow</h3>
          <ul>
            <li><a href="https://www.youtube.com/@hijinksuno">YouTube</a></li>
            <li><a href="https://discord.gg/H48SPgVdUF">Discord</a></li>
            <li><a href="https://mastodon.gamedev.place/@high">Mastodon</a></li>
            <li><a href="https://t.me/hijink">Telegram</a></li>
            <li><a href="https://highlyintegratedgayhijink.itch.io/">itch.io</a></li>
          </ul>
        </div>
        <div class="panel">
          <h3>The studio</h3>
          <p>Highly Integrated Gay Hijinks (HIGH) makes games and small tools. More at <a href="https://hijinks.uno/">hijinks.uno</a>.</p>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap">
      <a href="https://hijinks.uno/"><img src={`${BASE}/logo/high-studio-logo.svg`} alt="Highly Integrated Gay Hijinks" /></a>
      <span>Void Junker © Highly Integrated Gay Hijinks. Screenshots and art may be used in coverage of the game.</span>
    </div>
  </footer>
</body>
</html>
